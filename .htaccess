# .htaccess cafetiereagrain.fr
# MODE MIGRATION : toute URL non-asset envoyee vers index.php (page attente)
# Quand le site complet est pret, basculer sur le .htaccess "production"

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Bloquer fichiers sensibles
<FilesMatch "^\.env|^\.htaccess|^\.gitignore|^\.gitattributes|composer\.(json|lock)|\.md$|^\.ovhconfig$|^index-full\.php\.backup$">
    Require all denied
</FilesMatch>

# Bloquer dossiers sensibles
RedirectMatch 404 ^/(app|config|database|vendor|partials|scripts|_data|\.git|\.github)(/|$)

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Si fichier statique reel existe (CSS, JS, images, fonts), servir direct
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^.*$ - [L]

    # robots.txt + favicon : servir direct
    RewriteRule ^(robots\.txt|favicon\.ico)$ - [L]

    # Tout le reste -> index.php (page attente)
    RewriteRule ^.*$ index.php [L,QSA]
</IfModule>

DirectoryIndex index.php
